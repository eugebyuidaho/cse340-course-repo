<%- include('partials/header') %>

   <main>
       <h1><%= project.title %></h1>

       <p><%= project.description %></p>

       <p><strong>Date:</strong>
          <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %>
       </p>

       <p><strong>Location:</strong> <%= project.location %></p>

       <p><strong>Organization:</strong>
          <a href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a>
       </p>

       <p><a href="/assign-categories/<%= project.project_id %>">Edit Categories</a></p>

   </main>

   <%- include('partials/footer') %>