<%- include('partials/header') %>

   <main>
       <h1><%= title %></h1>

       <ul>
           <% projects.forEach(project => { %>
           <li>
               <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) %>:
               <strong><a href="/project/<%= project.project_id %>"><%= project.title %></a></strong>
               (<a href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a>)
           </li>
           <% }); %>
       </ul>

   </main>

   <%- include('partials/footer') %>